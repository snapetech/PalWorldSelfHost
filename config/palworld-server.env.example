PALWORLD_INSTALL_DIR=/srv/palworld/server
PALWORLD_STEAMCMD=/usr/local/bin/steamcmd
# native-linux is the default. wine-windows is an opt-in x86-64 Linux-hosted
# Windows depot used for current PalDefender/UE4SS support.
PALWORLD_RUNTIME=native-linux
PALWORLD_WINE_PREFIX=/var/lib/palworld/wine-prefix
PALWORLD_WINEDEBUG=-all
PALWORLD_WINE_DLL_OVERRIDES="d3d9=n,b;dwmapi=n,b"
PALWORLD_USER=palworld
PALWORLD_GROUP=palworld
PALWORLD_STATE_DIR=/var/lib/palworld
PALWORLD_BACKUP_LOCAL_ROOT=/var/backups/palworld
PALWORLD_RCLONE_DEST=remote:game-servers/palworld
RCLONE_CONFIG=/var/lib/palworld/.config/rclone/rclone.conf
PALWORLD_REQUIRE_LVM_BACKUP=false
PALWORLD_PUBLIC_DIR=/srv/static/palworld
PALWORLD_EXPECTED_HOSTNAME=
PALWORLD_PORT=8211
PALWORLD_PUBLIC_IP=
PALWORLD_BIND_IP=
PALWORLD_HAIRPIN_NAT_ENABLED=false
PALWORLD_LAN_CIDR=192.168.0.0/16
PALWORLD_NETWORK_INTERFACE=
PALWORLD_SERVER_NAME="50% XP Rate, No Raids, 25 Pals per Base, No Drop on Death."
PALWORLD_SERVER_DESCRIPTION="Live map and server status: https://example.com/palworld"
PALWORLD_PLAYER_EXP_RATE=0.5
PALWORLD_BACKUP_RETENTION_DAYS=14
PALWORLD_ADMIN_PASSWORD=generate-a-long-random-secret
PALWORLD_REST_PORT=8212
PALWORLD_OPS_BIND=127.0.0.1
PALWORLD_OPS_PORT=8213
PALWORLD_OPS_TOKEN=generate-a-separate-long-random-secret
PALWORLD_OPS_MODERATOR_TOKEN=
PALWORLD_OPS_VIEWER_TOKEN=
# Optional independent bearer credential restricted to documented read-only
# /api/v1/integration/* routes. Never reuse an operator/session token.
PALWORLD_OPS_INTEGRATION_TOKEN=
PALWORLD_OPS_SESSION_TTL_SECONDS=28800
PALWORLD_OPS_SECURE_COOKIE=false
PALWORLD_PUBLIC_PROBE_URL=
PALWORLD_PUBLIC_PROBE_ALLOW_HTTP=false
PALWORLD_RCON_PORT=25575
PALWORLD_RCON_ENABLED=false
PALWORLD_BACKUP_MAX_AGE_HOURS=26
PALWORLD_ALERT_COMMAND=
PALWORLD_WEBHOOK_URL=
PALWORLD_DISCORD_WEBHOOK_URL=
PALWORLD_NTFY_URL=
PALWORLD_GOTIFY_URL=
PALWORLD_MODERATION_ENABLED=false
PALWORLD_NOTIFY_PLAYER_EVENTS=false
PALWORLD_UPDATE_CHECK_MINUTES=30
PALWORLD_UPDATE_WARN_MINUTES=30
PALWORLD_UPDATE_MAX_DEFERRAL_HOURS=12
PALWORLD_STEAM_BUILD_PIN=
PALWORLD_BUILD_SNAPSHOT_ROOT=/var/backups/palworld/.builds
PALWORLD_BUILD_SNAPSHOT_RETENTION=2
PALWORLD_MAINTENANCE_WAIT_SECONDS=300
PALWORLD_RESTART_WARN_SECONDS=60
PALWORLD_BACKUP_HOURLY_RETENTION_HOURS=48
PALWORLD_BACKUP_DAILY_RETENTION_DAYS=14
PALWORLD_BACKUP_WEEKLY_RETENTION_DAYS=90
PALWORLD_CRASH_LIMIT=5
PALWORLD_CRASH_WINDOW_MINUTES=15
PALWORLD_HEALTH_RECOVERY_ENABLED=true
PALWORLD_STALL_FAILURE_THRESHOLD=3
PALWORLD_MEMORY_RESTART_GIB=0
PALWORLD_MEMORY_RESTART_DEFER_PLAYERS=true
PALWORLD_RECOVERY_COOLDOWN_MINUTES=30
PALWORLD_RECOVERY_WINDOW_HOURS=6
PALWORLD_RECOVERY_MAX_RESTARTS=3
PALWORLD_AUTO_PAUSE_ENABLED=false
PALWORLD_AUTO_PAUSE_EMPTY_MINUTES=30
PALWORLD_MATRIX_HOMESERVER=
PALWORLD_MATRIX_ACCESS_TOKEN=
PALWORLD_MATRIX_ROOMS=
PALWORLD_MATRIX_ADMINS=
# Optional guild-scoped Discord slash-command bot. Use a dedicated application,
# channel allowlist, and Discord user-ID allowlists; do not reuse webhook tokens.
PALWORLD_DISCORD_BOT_TOKEN=
PALWORLD_DISCORD_APPLICATION_ID=
PALWORLD_DISCORD_GUILD_ID=
PALWORLD_DISCORD_CONTROL_CHANNELS=
PALWORLD_DISCORD_ADMINS=
PALWORLD_DISCORD_MODERATORS=
# Optional game-chat-to-Discord relay. A local game adapter must POST the
# documented event contract to the loopback listener. Global chat only is the
# conservative default; generate an independent token of at least 24 characters.
# The exact-confirmed validation transaction sends and deletes one probe in the
# chat channel; that channel must belong to the configured guild.
PALWORLD_DISCORD_CHAT_CHANNEL=
PALWORLD_CHAT_RELAY_ENABLED=false
PALWORLD_CHAT_RELAY_TOKEN=
PALWORLD_CHAT_RELAY_PORT=8215
PALWORLD_CHAT_RELAY_CATEGORIES=global
# Volatile UE4SS event spool. Keep this on /run or /dev/shm; the Wine runtime
# inherits it and the host adapter deletes accepted events after forwarding.
PALWORLD_GAME_HOOK_SPOOL=/run/palworld/game-hook
# Optional offline parser override. The file is still required to match the
# source-pinned SHA-256 embedded in save-intelligence.py.
PALWORLD_SAVE_PARSER_PATH=
# Optional Palworld 1.0 Game Data actor snapshots. Some dedicated-server
# builds do not provide /v1/api/game-data; that is reported as unsupported and
# never degrades ordinary REST/server health.
PALWORLD_GAME_DATA_ENABLED=false
