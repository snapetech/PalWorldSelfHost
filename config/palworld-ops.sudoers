palworld ALL=(root) NOPASSWD: /usr/local/lib/palworld/graceful-restart.sh, /usr/local/lib/palworld/backup.sh, /usr/local/lib/palworld/ops-restore.sh, /usr/local/lib/palworld/ops-update.sh, /usr/local/lib/palworld/ops-build-rollback.sh, /usr/local/lib/palworld/ops-config-recovery.sh, /usr/local/lib/palworld/ops-save-repair.sh, /usr/local/lib/palworld/ops-lifecycle.sh start, /usr/local/lib/palworld/ops-lifecycle.sh stop STOP\ SERVER, /usr/local/lib/palworld/rcon-firewall.py check, /usr/local/lib/palworld/ops-rcon-toggle.sh enable ENABLE\ PRIVATE\ RCON, /usr/local/lib/palworld/ops-rcon-toggle.sh disable DISABLE\ PRIVATE\ RCON
