[Unit]
Description=Optional Palworld Matrix and Discord control bot
After=network-online.target palworld.service
Wants=network-online.target
[Service]
User=palworld
Group=palworld
EnvironmentFile=/etc/palworld-server.env
ExecStart=/usr/local/lib/palworld/admin-bot.py
Restart=on-failure
RestartSec=10
PrivateTmp=true
ProtectHome=true
UMask=0077
[Install]
WantedBy=multi-user.target
