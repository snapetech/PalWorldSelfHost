[Unit]
Description=PalWorldSelfHost volatile UE4SS chat-event adapter
After=palworld-bot.service
Wants=palworld-bot.service

[Service]
Type=simple
User=palworld
Group=palworld
Environment=HOME=/var/lib/palworld
Environment=PALWORLD_ENV_FILE=/etc/palworld-server.env
EnvironmentFile=/etc/palworld-server.env
RuntimeDirectory=palworld
RuntimeDirectoryMode=0700
ExecStart=/usr/local/lib/palworld/game-hook-adapter.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/palworld /var/lib/palworld

[Install]
WantedBy=multi-user.target
